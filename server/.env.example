# Kopyala: cp .env.example .env
PORT=4000
NODE_ENV=development

# docker compose up -d ile gelen veritabanı
DATABASE_URL=postgres://rosebud:rosebud@localhost:5432/rosebud
DATABASE_URL_TEST=postgres://rosebud:rosebud@localhost:5432/rosebud_test

# Üretimde mutlaka uzun ve rastgele bir değer kullanın
JWT_SECRET=degistir-beni
JWT_EXPIRES_IN=8h

# Arayüzün adresi (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Bilet ekleri
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Sürekli müşteri aktarımı için eski platformun kullanacağı anahtar
INTEGRATION_API_KEY=degistir-beni-entegrasyon

# Seed: kaç sahte kayıt üretilsin (fizibilitedeki hacim: 16000 müşteri, 50000 çağrı)
SEED_CUSTOMERS=2000
SEED_CALLS=10000
